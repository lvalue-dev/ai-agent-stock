# Google Gemini API (무료 티어: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# 한국투자증권 (KIS) API (https://apiportal.koreainvestment.com)
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_ACCOUNT_NO=your_account_number_here   # 예: 50123456
KIS_ACCOUNT_PROD_CODE=01                   # 계좌 상품코드 (보통 01)

# 실전/모의 투자 구분 (real 또는 virtual)
KIS_MODE=virtual

# 에이전트 설정
MAX_DEBATE_ROUNDS=3          # 토론 최대 라운드 수
AUTO_TRADE_ENABLED=false     # 자동 매매 활성화 여부 (true/false)
MAX_TRADE_AMOUNT=100000      # 1회 최대 매매금액 (원)
