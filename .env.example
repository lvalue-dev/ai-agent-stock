# LLM 제공자 선택 (groq 또는 gemini)
# Groq 추천: 하루 14,400 요청 무료 (https://console.groq.com)
LLM_PROVIDER=groq

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (대안, https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# 한국투자증권 (KIS) API (https://apiportal.koreainvestment.com)
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_ACCOUNT_NO=your_account_number_here   # 예: 50123456
KIS_ACCOUNT_PROD_CODE=01                   # 계좌 상품코드 (보통 01)

# 실전/모의 투자 구분 (real 또는 virtual)
KIS_MODE=real

# 시세 시장 구분: UN=KRX+넥스트레이드 통합 (프리마켓 08:00~ / 애프터마켓 ~20:00 반영, 기본값)
#               J=KRX 정규장만, NX=넥스트레이드만. NXT 미신청 계좌/비거래 종목은 자동으로 KRX 로 폴백
KIS_MARKET=UN

# 에이전트 설정
MAX_DEBATE_ROUNDS=3          # 토론 최대 라운드 수
AUTO_TRADE_ENABLED=false     # 자동 매매 활성화 여부 (true/false)
MAX_TRADE_AMOUNT=100000      # 1회 최대 매매금액 (원)

# Discord Webhook (선택, 비워두면 전송 안 함)
# 설정 방법: Discord 채널 → 편집 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=

# ── 실시간 (웹소켓) 모드: python main.py --realtime ──────────────────
# 감시 종목코드 (쉼표 구분). 비워두면 KOSPI/KOSDAQ 거래량 상위 종목을 자동 선정
WATCHLIST=
WATCHLIST_AUTO_LIMIT=20          # 자동 선정 시 종목 수
REALTIME_MAX_SUBSCRIPTIONS=40    # KIS 웹소켓 세션당 등록 한도 (실전 41건)
REALTIME_ORDERBOOK=false         # 호가(H0STASP0)도 구독 (종목당 등록 2건 소비)

# 신호 감지 임계값
REALTIME_PRICE_SPIKE_PCT=2.0       # 5분 내 등락률 (%)
REALTIME_VOLUME_SURGE_RATIO=3.0    # 1분 거래량 / 평균 1분 거래량
REALTIME_STRENGTH_THRESHOLD=150    # 체결강도
REALTIME_IMBALANCE_RATIO=2.5       # 호가 잔량 비율
REALTIME_SIGNAL_COOLDOWN_SEC=600   # 같은 종목·신호 재발생 억제 (초)
REALTIME_TRIGGER_COOLDOWN_SEC=900  # 에이전트 재실행 최소 간격 (초, LLM 호출 폭주 방지)
REALTIME_SNAPSHOT_PATH=data/realtime_snapshot.json  # 대시보드용 스냅샷
REALTIME_LIVE_DIR=static/live       # 차트 피드 디렉터리 (Streamlit 정적 서빙 경로)
REALTIME_BACKFILL_PAGES=4           # 시작 시 당일 분봉 백필 (30분 × 페이지, 0=생략)
